# Of a server directory only server.yaml belongs to the chart; Dockerfiles, sources
# and dependencies stay out of it. No negation rules: Helm applies them as "ignore
# everything that does not match", which would drop Chart.yaml.
*/src
*/test
*/dist
*/node_modules
*/Dockerfile
*/.dockerignore
*/package.json
*/pnpm-lock.yaml
*/tsconfig*.json
*/*.md
*/.env*
