{
  "name": "mcp-ssh-server",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server that runs commands on a fixed list of SSH hosts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
