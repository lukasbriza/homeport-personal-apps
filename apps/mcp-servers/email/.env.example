# Local test of the email server image. Copy to .env (ignored by git), fill in the two
# empty values and run from the repository root:
#   docker run --rm -p 9557:9557 --user 10001:10001 --env-file apps/mcp-servers/email/.env ghcr.io/wh1isper/mcp-email-server:1.13.3 streamable-http
# Production values come from Infisical, never from this file.
MCP_HOST=0.0.0.0
MCP_ALLOWED_HOSTS=localhost
HOME=/tmp
MCP_EMAIL_SERVER_ACCOUNT_NAME=seznam
MCP_EMAIL_SERVER_EMAIL_ADDRESS=
MCP_EMAIL_SERVER_PASSWORD=
MCP_EMAIL_SERVER_IMAP_HOST=imap.seznam.cz
MCP_EMAIL_SERVER_IMAP_PORT=993
MCP_EMAIL_SERVER_ACCOUNT_ALLOWED_MUTATIONS=
MCP_EMAIL_SERVER_ALLOWED_RECIPIENTS=
