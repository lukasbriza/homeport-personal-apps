{
  "name": "@lukasbriza/homeport-personal-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Personal self-hosted apps for homeport, deployed to k3s via ArgoCD",
  "author": "https://github.com/lukasbriza",
  "type": "module",
  "workspaces": [
    "./apps/*",
    "./packages/*",
    "./templates/*"
  ],
  "scripts": {
    "build": "turbo build",
    "cleanup": "turbo run cleanup --no-daemon && pnpm run postcleanup",
    "postcleanup": "rimraf .eslintcache tsconfig.tsbuildinfo node_modules",
    "dev": "turbo dev --filter=\"./apps/*\" --filter=\"./packages/*\"",
    "docker:build": "docker compose -f docker/dev/docker-compose.yaml build",
    "docker:dev": "docker compose -f docker/dev/docker-compose.yaml run --rm --service-ports dev sh -c \"pnpm install && exec bash\"",
    "docker:shell": "docker compose -f docker/dev/docker-compose.yaml run --rm --service-ports dev bash",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint --no-daemon",
    "lint:fix": "turbo run lint:fix --no-daemon",
    "prepare": "node scripts/husky-prepare.js",
    "prepare:husky": "husky",
    "test": "turbo test",
    "ts": "turbo run ts --no-daemon"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.4",
    "@lukasbriza/eslint-config": "workspace:*",
    "@lukasbriza/prettier-config": "workspace:*",
    "@lukasbriza/ts-config": "workspace:*",
    "@turbo/gen": "2.10.4",
    "@types/node": "22.20.1",
    "eslint": "9.39.4",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.4",
    "rimraf": "6.1.3",
    "turbo": "2.10.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  },
  "devDependencies": {
    "dotenv-cli": "8.0.0"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
